<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EcosenaApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EcosenaApp.Views"
    xmlns:auth="clr-namespace:EcosenaApp.Views.Auth"
    xmlns:home="clr-namespace:EcosenaApp.Views.Home"
    xmlns:blog="clr-namespace:EcosenaApp.Views.Blog"
    Title="EcosenaApp"
    Shell.NavBarIsVisible="False">

    <ShellContent
        ContentTemplate="{DataTemplate views:SplashPage}"
        Route="SplashPage" />

    <ShellContent
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Route="LoginPage"/>

    <ShellContent
        ContentTemplate="{DataTemplate auth:SingUpPage}"
        Route="SingUpPage" />

    <ShellContent
        ContentTemplate="{DataTemplate auth:ForgotPassPage}"
        Route="ForgotPassPage" />    
    
    <ShellContent
        ContentTemplate="{DataTemplate home:HomePage}"
        Route="HomePage" />
    
    <ShellContent
        ContentTemplate="{DataTemplate blog:BlogPage}"
        Route="BlogPage" />

</Shell>
