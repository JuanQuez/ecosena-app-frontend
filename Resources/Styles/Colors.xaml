<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ====| PRIMARY COLORS |==== -->
    <Color x:Key="Primary">#174F42</Color>
    <Color x:Key="Secondary">#1F6E5A</Color>
    <Color x:Key="Tertiary">#2E8B72</Color>

    
    <!-- ====| ACCENT COLORS |==== -->
    <Color x:Key="Fantasy">#7BD7AB</Color>
    <Color x:Key="Seaplant">#43C492</Color>
    <Color x:Key="Lime">#65CD9E</Color>
    <Color x:Key="Summer">#7BC586</Color>
    <Color x:Key="ActionDeleteVariant">#A53632</Color>
    <Color x:Key="WhiteGradient">#99E0E0E0</Color>
    
    <!-- ====| NEUTRAL |==== -->
    <Color x:Key="WhiteBase">#F0F0F0</Color>
    <Color x:Key="BlackBase">#1E1E1E</Color>
    <Color x:Key="GrayLight">#E0E0E0</Color>
    <Color x:Key="GrayMedium">#C9CED3</Color>
    <Color x:Key="GrayMidnight">#5F6B73</Color>
    <Color x:Key="GrayDark">#353535</Color>

    <!-- ====| STATUS COLORS |===== -->
    <Color x:Key="StatusSolved">#28A745</Color>
    <Color x:Key="StatusPending">#F4B400</Color>
    <Color x:Key="StatusUnderReview">#2D7FF9</Color>
    <Color x:Key="StatusAdvertisement">#FF8080</Color>

    <!-- ====| ACTION COLOR |===== -->
    <Color x:Key="ActionEdit">#28A745</Color>
    <Color x:Key="ActionDelete">#E03C2B</Color>

    <!-- =====| GRADIENTS |===== -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Primary}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Tertiary}" Offset="0.5"/>
        <GradientStop Color="{StaticResource Secondary}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InnerShadow" StartPoint="0,0" EndPoint="0,1.0">
        <GradientStop Color="{StaticResource GrayMidnight}" Offset="0.0" />
        <GradientStop Color="{StaticResource Primary}" Offset="0.25" />
        <GradientStop Color="{StaticResource Primary}" Offset="1.0" />
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="InnerShadowBtn" StartPoint="0,0" EndPoint="0,1.0">
        <GradientStop Color="{StaticResource GrayMidnight}" Offset="0.0" />
        <GradientStop Color="{StaticResource Primary}" Offset="0.1" />
        <GradientStop Color="{StaticResource Primary}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource ActionDelete}" Offset="0.0"/>
        <GradientStop Color="{StaticResource ActionDeleteVariant}" Offset="0.5"/>
        <GradientStop Color="{StaticResource ActionDelete}" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ====| SOLID COLOR BRUSHES |==== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBaseBrush" Color="{StaticResource WhiteBase}"/>
    <SolidColorBrush x:Key="BlackBaseBrush" Color="{StaticResource BlackBase}"/>
    <SolidColorBrush x:Key="GrayLightBrush" Color="{StaticResource GrayLight}"/>
    <SolidColorBrush x:Key="GrayMediumBrush" Color="{StaticResource GrayMedium}"/>
    <SolidColorBrush x:Key="GrayMidnightBrush" Color="{StaticResource GrayMidnight}"/>
    <SolidColorBrush x:Key="GrayDarkBrush" Color="{StaticResource GrayDark}"/>
    <SolidColorBrush x:Key="StatusSolvedBrush" Color="{StaticResource StatusSolved}"/>
    <SolidColorBrush x:Key="StatusPendingBrush" Color="{StaticResource StatusPending}"/>
    <SolidColorBrush x:Key="StatusUnderReviewBrush" Color="{StaticResource StatusUnderReview}"/>
    <SolidColorBrush x:Key="ActionEditBrush" Color="{StaticResource ActionEdit}"/>
    <SolidColorBrush x:Key="ActionDeleteBrush" Color="{StaticResource ActionDelete}"/>
    
</ResourceDictionary>