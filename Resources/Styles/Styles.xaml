<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ====| LABELS |==== -->
    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontFamily" Value="InterExtraBold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="TextColor" Value="{StaticResource BlackBase}"/>
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontFamily" Value="InterExtraBold"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="TextColor" Value="{StaticResource BlackBase}"/>
    </Style>

    <Style x:Key="H3" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="TextColor" Value="{StaticResource BlackBase}"/>
    </Style>

    <Style x:Key="TextMedium" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{StaticResource BlackBase}"/>
    </Style>
    
    <Style x:Key="TextRegular" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource BlackBase}"/>
    </Style>

    <Style x:Key="TextSecondary" TargetType="Label">
        <Setter Property="FontFamily" Value="InterLight"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource GrayMidnight}"/>
    </Style>

    <Style x:Key="TextPlaceholder" TargetType="Label">
        <Setter Property="FontFamily" Value="InterLight"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource GrayMedium}"/>
    </Style>

    <Style x:Key="Stats" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="TextColor" Value="{StaticResource Primary}"/>
    </Style>

    <!-- ====| BUTTONS |==== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterBold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
        <Setter Property="TextColor" Value="{StaticResource WhiteBase}"/>
        <Setter Property="CornerRadius" Value="50"/>
        <Setter Property="Padding" Value="30, 15" />
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource BlackBase}"
                Offset="0,1"
                Radius="5"
                Opacity="0.25"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterBold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="BackgroundColor" Value="{StaticResource GrayLight}"/>
        <Setter Property="TextColor" Value="{StaticResource Primary}"/>
        <Setter Property="BorderColor" Value="{StaticResource Primary}"/>
        <Setter Property="BorderWidth" Value="1.5"/>
        <Setter Property="CornerRadius" Value="50"/>
        
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource BlackBase}"
                Offset="0,1"
                Radius="5"
                Opacity="0.25"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterBold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Background" Value="{StaticResource DangerGradient}"/>
        <Setter Property="TextColor" Value="{StaticResource WhiteBase}"/>
        <Setter Property="CornerRadius" Value="50"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource BlackBase}"
                Offset="0,1"
                Radius="5"
                Opacity="0.25"/>
            </Setter.Value>
        </Setter>
    </Style>

        <!-- ====| INPUTS |==== -->
        <Style x:Key="InputField" TargetType="Entry">
            <Setter Property="FontFamily" Value="InterRegular"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor" Value="{StaticResource BlackBase}"/>
            <Setter Property="PlaceholderColor" Value="{StaticResource GrayMedium}"/>
            <Setter Property="BackgroundColor" Value="{StaticResource WhiteBase}"/>

            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- ====| CARD BOX MODAL |==== -->
    <Style x:Key="AuthCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource GrayLight}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 35"/>
        <Setter Property="Margin" Value="30,20"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource BlackBase}"
                Offset="0,1"
                Radius="5"
                Opacity="0.25"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====| INPUT CARD |==== -->
    <Style x:Key="InputCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource WhiteBase}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource BlackBase}"
                Offset="0,1"
                Radius="5"
                Opacity="0.25"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====| ACTION CHIP (Blog/Cards) |==== -->
    <Style x:Key="ActionChip" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 50" />
        <Setter Property="BackgroundColor" Value="{StaticResource WhiteBase}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="ActionChipPrimary" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- ====| CONTENT CHIP (Info/Tags) |==== -->
    <Style x:Key="ContentChip" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 15" />
        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- ====| BLOG PAGE STYLES |==== -->
    <Style x:Key="PostCardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource GrayLight}"/>
        <Setter Property="HeightRequest" Value="220"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 30"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource BlackBase}"
                Offset="0,2"
                Radius="6"
                Opacity="0.15"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TagLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource GrayLight}"/>
    </Style>

    <Style x:Key="PostTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterExtraBold"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="TextColor" Value="{StaticResource GrayDark}"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="MaxLines" Value="2"/>
    </Style>

    <Style x:Key="PostDescLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterLight"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{StaticResource GrayDark}"/>
        <Setter Property="LineBreakMode" Value="TailTruncation"/>
    </Style>

    <Style x:Key="DateLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterLight"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextColor" Value="{StaticResource GrayDark}"/>
    </Style>

    <Style x:Key="AuthorLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource GrayDark}"/>
    </Style>

    <!-- ====| LINKS |==== -->
    <Style x:Key="LinkText" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource Secondary}"/>
        <Setter Property="TextDecorations" Value="Underline"/>
    </Style>

    <!-- ====| ADVERTISMENT |==== -->
    <Style x:Key="WarningText" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource StatusAdvertisement}"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>
    

</ResourceDictionary>