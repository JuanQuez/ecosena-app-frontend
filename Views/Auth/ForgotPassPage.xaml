<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcosenaApp.Views.Auth.ForgotPassPage"
             BackgroundImageSource="bkg_ecosena_auth.png"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <ScrollView>
            <Grid RowDefinitions="*, Auto" VerticalOptions="Center">

                <VerticalStackLayout Grid.Row="0" Padding="10,10,10,20">
                    <Border>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,1" Radius="5" Opacity="0.25"/>
                        </Border.Shadow>
                        <Image Source="icon_logo.svg" HeightRequest="86" WidthRequest="80" HorizontalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <Border Grid.Row="1" Style="{StaticResource AuthCard}">
                    <VerticalStackLayout Spacing="20" Padding="30,35">

                        <Label Text="Recupera tu cuenta" Style="{StaticResource H1}" HorizontalOptions="Center"/>

                        <BoxView HeightRequest="1" MaximumWidthRequest="246" MinimumWidthRequest="246" Color="{StaticResource GrayMedium}"/>

                        <!-- ====| PASO 1 |==== -->
                        <VerticalStackLayout x:Name="Paso1Section" Spacing="20">

                            <Border Style="{StaticResource InputCard}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Image Grid.Column="0" Source="icon_document_id.svg" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <Entry Grid.Column="1" Text="{Binding Documento}" Style="{StaticResource InputField}" Placeholder="Documento de identidad" Keyboard="Numeric"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource InputCard}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Image Grid.Column="0" Source="icon_email.svg" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <Entry Grid.Column="1" Text="{Binding Email}" Style="{StaticResource InputField}" Placeholder="E-Mail" Keyboard="Email"/>
                                </Grid>
                            </Border>

                            <Label Text="Te enviaremos un código para reestablecer la contraseña"
                                   Style="{StaticResource TextRegular}"
                                   TextColor="{StaticResource GrayMidnight}"
                                   HorizontalTextAlignment="Center"/>

                            <Grid>
                                <Button Text="Enviar código"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SolicitarCommand}"
                                        IsVisible="{Binding IsNotBusy}"/>
                                <Border Background="{StaticResource PrimaryGradient}"
                                        StrokeThickness="0"
                                        HorizontalOptions="Fill"
                                        Padding="30,15"
                                        IsVisible="{Binding IsBusy}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="50"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="{StaticResource BlackBase}" Offset="0,1" Radius="5" Opacity="0.25"/>
                                    </Border.Shadow>
                                    <ActivityIndicator IsRunning="True"
                                                       Color="{StaticResource WhiteBase}"
                                                       HeightRequest="24"
                                                       HorizontalOptions="Center"/>
                                </Border>
                            </Grid>

                        </VerticalStackLayout>

                        <!-- ====| PASO 2 |==== -->
                        <VerticalStackLayout x:Name="Paso2Section" Spacing="20">

                            <Border Style="{StaticResource InputCard}">
                                <Entry Text="{Binding Codigo}" Style="{StaticResource InputField}" Placeholder="Código de verificación"/>
                            </Border>

                            <Border Style="{StaticResource InputCard}">
                                <Entry Text="{Binding NuevaContraseña}" Style="{StaticResource InputField}" Placeholder="Nueva contraseña" IsPassword="True"/>
                            </Border>

                            <Border Style="{StaticResource InputCard}">
                                <Entry Text="{Binding ConfirmacionContraseña}" Style="{StaticResource InputField}" Placeholder="Confirmar contraseña" IsPassword="True"/>
                            </Border>

                            <Grid>
                                <Button Text="Restablecer contraseña"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ReestablecerCommand}"
                                        IsVisible="{Binding IsNotBusy}"/>
                                <Border Background="{StaticResource PrimaryGradient}"
                                        StrokeThickness="0"
                                        HorizontalOptions="Fill"
                                        Padding="30,15"
                                        IsVisible="{Binding IsBusy}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="50"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="{StaticResource BlackBase}" Offset="0,1" Radius="5" Opacity="0.25"/>
                                    </Border.Shadow>
                                    <ActivityIndicator IsRunning="True"
                                                       Color="{StaticResource WhiteBase}"
                                                       HeightRequest="24"
                                                       HorizontalOptions="Center"/>
                                </Border>
                            </Grid>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" MaximumWidthRequest="246" MinimumWidthRequest="246" Color="{StaticResource GrayMedium}"/>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="¿Recordaste la contraseña?" Style="{StaticResource TextPlaceholder}" TextColor="{StaticResource GrayDark}"/>
                            <Label Text="Inicia sesión" Style="{StaticResource LinkText}" TextColor="{StaticResource Seaplant}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLoginGoBcak"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
