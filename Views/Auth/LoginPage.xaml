<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcosenaApp.Views.Auth.LoginPage"
             BackgroundImageSource="bkg_ecosena_auth.png"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <ScrollView>
            <Grid RowDefinitions="*, Auto" VerticalOptions="Center">

                <!-- ====| LOGO |==== -->
                <VerticalStackLayout Grid.Row="0" Padding="10,10,10,20">
                    <Border>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                Offset="0,1"
                                Radius="5"                
                                Opacity="0.25"/>
                        </Border.Shadow>
                        <Image Source="icon_logo.svg"
                            HeightRequest="86"
                            WidthRequest="80"
                            HorizontalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <!-- ====| FORM CARD |==== -->
                <Border Grid.Row="1" Style="{StaticResource AuthCard}">
                    <VerticalStackLayout Spacing="20" Padding="30, 35">

                        <VerticalStackLayout Spacing="5">
                            <!-- ====| TITLES |==== -->
                            <Label Text="Iniciar sesión"
                                   Style="{StaticResource H1}"
                               HorizontalOptions="Center"/>
                            <Label Text="Accede a tu cuenta"
                               Style="{StaticResource TextRegular}"
                                   TextColor="{StaticResource GrayMidnight}"
                               HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 MaximumWidthRequest="246"
                                 MinimumWidthRequest="246"
                                 Color="{StaticResource GrayMedium}"/>

                        <!-- ====| INPUTS |==== -->
                        <Border Style="{StaticResource InputCard}">
                            <Grid ColumnDefinitions="Auto, *">
                                <Image Grid.Column="0"
                                       Source="icon_document_id.svg"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Style="{StaticResource InputField}"
                                       Placeholder="Documento de identidad"
                                       Keyboard="Numeric"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource InputCard}">
                            <Grid ColumnDefinitions="Auto, *">
                                <Image Grid.Column="0"
                                       Source="icon_lock_pass.svg"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Style="{StaticResource InputField}"
                                       Placeholder="Contraseña"
                                       BackgroundColor="Transparent"
                                       IsPassword="True"/>
                            </Grid>
                        </Border>

                        <!-- ====| FORGOT PASSWORD |==== -->
                        <HorizontalStackLayout HorizontalOptions="Center"
                                               Spacing="4">
                            <Label Text="¿Olvidaste tu contraseña?"
                                   Style="{StaticResource TextPlaceholder}"
                                   TextColor="{StaticResource GrayDark}"/>
                            <Label Text="Recupérala"
                                   Style="{StaticResource LinkText}"/>
                        </HorizontalStackLayout>

                        <!-- ====| SUBMIT BUTTON |==== -->
                        <Button Text="Ingresar"
                                Style="{StaticResource PrimaryButton}"/>

                        <!-- ====| REMEMBER ME |==== -->
                        <HorizontalStackLayout HorizontalOptions="Center">
                            <CheckBox Color="{StaticResource Seaplant}"/>
                            <Label Text="Recordarme"
                                   Style="{StaticResource TextMedium}"
                                   FontSize="14"
                                   TextColor="{StaticResource Seaplant}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>


                        <!-- ====| SIGN UP |==== -->
                        <HorizontalStackLayout HorizontalOptions="Center"
                                               Spacing="4">
                            <Label Text="¿No tienes una cuenta?"
                                   Style="{StaticResource TextPlaceholder}"
                                   TextColor="{StaticResource GrayDark}"/>
                            <Label Text="Crea tu cuenta"
                                   Style="{StaticResource LinkText}"
                                   TextColor="{StaticResource Seaplant}"
                                   />
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1"
                                 MaximumWidthRequest="246"
                                 MinimumWidthRequest="246"
                                 Color="{StaticResource GrayMedium}"/>

                        <!-- ====| GUEST BUTTON |==== -->
                        <Button Text="Continuar sin iniciar sesión"
                                Style="{StaticResource SecondaryButton}"
                                FontFamily="InterRegular"
                                FontSize="14"
                                TextColor="{StaticResource GrayMidnight}"
                                BorderColor="{StaticResource GrayMidnight}"
                                />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>