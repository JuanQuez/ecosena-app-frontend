<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcosenaApp.Views.Auth.SingUpPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundImageSource="bkg_ecosena_auth.png"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <ScrollView>
            <Grid RowDefinitions="*, Auto" VerticalOptions="Center">

                <!-- ====| FORM CARD |==== -->
                <Border Grid.Row="1" Style="{StaticResource AuthCard}">
                    <VerticalStackLayout Spacing="20" Padding="30,35">

                        <!-- ====| TITLES |==== -->
                        <VerticalStackLayout Spacing="5" >
                            <Label Text="Registrarse"
                                   Style="{StaticResource H1}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Crea tu cuenta"
                                   Style="{StaticResource TextRegular}"
                                   TextColor="{StaticResource GrayMidnight}"
                                   HorizontalOptions="Center"/>

                            <!-- ====| WARNING |==== -->
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="6">
                                <Image Grid.Column="0"
                                       Source="icon_alert.svg"
                                       HeightRequest="16"
                                       WidthRequest="16"
                                       VerticalOptions="Start">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource StatusAdvertisement}" />
                                    </Image.Behaviors>
                                </Image>
                                <Label Grid.Column="1"
                                       Text="Recuerda: solo aprendices y funcionarios Sena activos pueden registrarse."
                                       Style="{StaticResource WarningText}"
                                       HorizontalOptions="Start"/>
                            </Grid>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 MaximumWidthRequest="246"
                                 MinimumWidthRequest="246"
                                 Color="{StaticResource GrayMedium}"/>

                        <!-- ====| INPUTS |==== -->
                        <Border Style="{StaticResource InputCard}">
                            <Grid ColumnDefinitions="Auto, *">
                                <Image Grid.Column="0"
                                       Source="icon_document_id.svg"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Style="{StaticResource InputField}"
                                       Placeholder="Documento de identidad"
                                       Keyboard="Numeric"
                                       Text="{Binding Documento}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource InputCard}">
                            <Grid ColumnDefinitions="Auto, *">
                                <Image Grid.Column="0"
                                       Source="icon_names_profile.svg"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Style="{StaticResource InputField}"
                                       Placeholder="Nombre"
                                       Text="{Binding Nombre}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource InputCard}">
                            <Grid ColumnDefinitions="Auto, *">
                                <Image Grid.Column="0"
                                       Source="icon_names_profile.svg"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Style="{StaticResource InputField}"
                                       Placeholder="Apellido"
                                       Text="{Binding Apellido}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource InputCard}">
                            <Grid ColumnDefinitions="Auto, *">
                                <Image Grid.Column="0"
                                       Source="icon_lock_pass.svg"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Style="{StaticResource InputField}"
                                       Placeholder="Contraseña"
                                       BackgroundColor="Transparent"
                                       IsPassword="True"
                                       Text="{Binding Contraseña}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource InputCard}">
                            <Grid ColumnDefinitions="Auto, *">
                                <Image Grid.Column="0"
                                       Source="icon_lock_pass.svg"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Style="{StaticResource InputField}"
                                       Placeholder="Repite la contraseña"
                                       BackgroundColor="Transparent"
                                       IsPassword="True"
                                       Text="{Binding ConfirmacionContraseña}"/>
                            </Grid>
                        </Border>

                        <!-- ====| SUBMIT BUTTON |==== -->
                        <Grid>
                            <Button Text="Registrarse"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RegisterCommand}"
                                    IsVisible="{Binding IsNotBusy}"/>
                            <Border Background="{StaticResource PrimaryGradient}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Fill"
                                    Padding="30,15"
                                    IsVisible="{Binding IsBusy}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="50"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource BlackBase}"
                                            Offset="0,1"
                                            Radius="5"
                                            Opacity="0.25"/>
                                </Border.Shadow>
                                <ActivityIndicator IsRunning="True"
                                                   Color="{StaticResource WhiteBase}"
                                                   HeightRequest="24"
                                                   HorizontalOptions="Center"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 MaximumWidthRequest="246"
                                 MinimumWidthRequest="246"
                                 Color="{StaticResource GrayMedium}"/>

                        <!-- ====| LOGIN LINK |==== -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="¿Ya tienes una cuenta?"
                                   Style="{StaticResource TextPlaceholder}"
                                   TextColor="{StaticResource GrayDark}"/>
                            <Label Text="Inicia sesión"
                                   Style="{StaticResource LinkText}"
                                   TextColor="{StaticResource Seaplant}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLoginGoBack"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
