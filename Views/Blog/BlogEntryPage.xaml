<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:EcosenaApp.Views.Controls"
    x:Class="EcosenaApp.Views.Blog.BlogEntryPage"
    Shell.NavBarIsVisible="False"
    BackgroundImageSource="bkg_ecosena_sections.png">

    <Grid RowDefinitions="Auto,*" Margin="20,10" RowSpacing="30">

        <!-- Top bar with back button, title, admin actions -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalOptions="Start">
            <ImageButton Source="icon_go_back_section.svg"
                         WidthRequest="45"
                         Clicked="OnBackClicked"
                         HorizontalOptions="Start"/>

            <Label Grid.Column="1"
                   Text="Blog Educativo"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center"
                   Style="{StaticResource H1}"
                   TextColor="{StaticResource WhiteBase}"/>

            <HorizontalStackLayout x:Name="AdminActions"
                                    Grid.Column="2"
                                    Spacing="10"
                                    IsVisible="False"
                                    HorizontalOptions="End">
                <ImageButton Source="icon_edit_entry.svg"
                             WidthRequest="32"
                             Clicked="OnEditarClicked"/>
                <ImageButton Source="icon_delete_entry.svg"
                             WidthRequest="32"
                             Clicked="OnEliminarClicked"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Content area (fills rest of screen) -->
        <Border Grid.Row="1" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30"/>
            </Border.StrokeShape>
            <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout VerticalOptions="Center">

                <!-- Card container (rounded) -->
                <Border StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>

                    <AbsoluteLayout>
                        <Image Source="bkg_ecosena_managment.png"
                               Aspect="AspectFill"
                               AbsoluteLayout.LayoutBounds="0,0,1,1"
                               AbsoluteLayout.LayoutFlags="All"/>

                        <VerticalStackLayout Spacing="20"
                                              Padding="30, 20"
                                              AbsoluteLayout.LayoutBounds="0,0,1,-1"
                                              AbsoluteLayout.LayoutFlags="WidthProportional">

                        <!-- Title -->
                        <Label x:Name="TitleLabel"
                               HorizontalTextAlignment="Center"
                               Style="{StaticResource H2}"
                               TextColor="{StaticResource BlackBase}"/>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" Color="{StaticResource GrayMedium}" Opacity="0.3"/>

                        <!-- Hero image rounded -->
                        <Border StrokeThickness="0" Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Image x:Name="MainImage"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Fill"/>
                        </Border>
                        <BoxView HeightRequest="1" Color="{StaticResource GrayMedium}" Opacity="0.3"/>
                        <!-- Body text -->
                        <Label x:Name="BodyLabel"
                               Style="{StaticResource TextMedium}"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource GrayDark}"/>

                        <!-- Author row aligned right -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="End" Padding="0,8,0,0">
                            <Label Grid.Column="0" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Label x:Name="AuthorLabel" Style="{StaticResource H3}" FontSize="14" TextColor="{StaticResource BlackBase}" VerticalOptions="Center"/>
                                <Border StrokeThickness="0" HeightRequest="36" WidthRequest="36">
                                    <Border.StrokeShape>
                                        <Ellipse />
                                    </Border.StrokeShape>
                                    <Image x:Name="AvatarImage" Source="avatar_autor.png" Aspect="AspectFill"/>
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                    </AbsoluteLayout>

                </Border>

            </VerticalStackLayout>
            </ScrollView>
        </Border>

        <controls:LoadingOverlayView Grid.Row="0" Grid.RowSpan="2" IsBusy="{Binding EstaProcesando}"/>

    </Grid>

</ContentPage>