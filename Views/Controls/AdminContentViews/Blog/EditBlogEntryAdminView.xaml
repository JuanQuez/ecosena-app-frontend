<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EcosenaApp.Views.Controls.EditBlogEntryAdminView">

    <Border StrokeThickness="0"
            StrokeShape="RoundRectangle 15"
            Margin="0, 10">

        <Grid>
            <Image Source="bkg_blog_entry_edit.png"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"
                   />

            <Grid RowDefinitions="*, Auto">

                <!-- Formulario sin scroll -->
                <VerticalStackLayout Grid.Row="0"
                                     Spacing="10"
                                     Padding="22,12,28,6"
                                     VerticalOptions="Center">

                    <Label Text="Editar Entrada"
                           FontFamily="InterExtraBold"
                           FontSize="20"
                           TextColor="{StaticResource GrayDark}"/>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Titulo:"
                               FontFamily="InterBold"
                               FontSize="15"
                               TextColor="{StaticResource GrayDark}"/>
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource WhiteBase}"
                                Padding="14,10">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource BlackBase}" Offset="0,1" Radius="3" Opacity="0.25"/>
                            </Border.Shadow>
                            <Entry x:Name="TituloEntry"
                                   Style="{StaticResource InputField}"
                                   FontFamily="InterExtraBold"
                                   FontSize="17"
                                   TextColor="{StaticResource GrayMidnight}"
                                   PlaceholderColor="{StaticResource GrayMedium}"
                                   Placeholder="Título de la entrada..."/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Portada:"
                               FontFamily="InterBold"
                               FontSize="15"
                               TextColor="{StaticResource GrayDark}"/>
                        <Border x:Name="PortadaBorder"
                                StrokeThickness="1.5"
                                Stroke="{StaticResource GrayMidnight}"
                                StrokeDashArray="4,4"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource WhiteBase}"
                                WidthRequest="64" HeightRequest="64"
                                HorizontalOptions="Start">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCambiarPortadaTapped"/>
                            </Border.GestureRecognizers>
                            <Image x:Name="PortadaImage"
                                   Source="icon_gallery_report.svg"
                                   WidthRequest="30" HeightRequest="30"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource GrayMidnight}"/>
                                </Image.Behaviors>
                            </Image>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Contenido:"
                               FontFamily="InterBold"
                               FontSize="15"
                               TextColor="{StaticResource GrayDark}"/>
                        <Border StrokeThickness="0"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource WhiteBase}"
                                HeightRequest="200"
                                Padding="12,10">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource BlackBase}" Offset="0,1" Radius="5" Opacity="0.25"/>
                            </Border.Shadow>
                            <Editor x:Name="ContenidoEditor"
                                    FontFamily="InterRegular"
                                    FontSize="15"
                                    HeightRequest="190"
                                    TextColor="{StaticResource GrayMidnight}"
                                    PlaceholderColor="{StaticResource GrayMedium}"
                                    Placeholder="Contenido de la entrada..."
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Start"/>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- Botones -->
                <VerticalStackLayout Grid.Row="1"
                                     Spacing="8"
                                     Padding="22,8,28,14">
                    <Button Text="Actualizar entrada"
                            Style="{StaticResource PrimaryButton}"
                            Padding="0"
                            HeightRequest="44"
                            Clicked="OnActualizarTapped"/>
                    <Button Text="Cancelar"
                            Style="{StaticResource DangerButton}"
                            Padding="0"
                            HeightRequest="44"
                            Clicked="OnCancelarTapped"/>
                </VerticalStackLayout>

            </Grid>
        </Grid>
    </Border>
</ContentView>
