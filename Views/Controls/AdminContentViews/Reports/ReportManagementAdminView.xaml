<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EcosenaApp.Views.Controls.ReportManagementAdminView">

    <Border StrokeThickness="0"
            StrokeShape="RoundRectangle 15"
            Margin="0, 10">

        <Grid>
            <Image Source="bkg_report_management.png"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"/>

            <Grid RowDefinitions="*, Auto" >

                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Spacing="16"
                                         Padding="20,12,20,12">

                        <Label x:Name="TituloLabel"
                               FontFamily="InterExtraBold"
                               FontSize="20"
                               TextColor="{StaticResource GrayDark}"
                               LineBreakMode="WordWrap"/>

                        <Border StrokeThickness="0" Padding="0" HeightRequest="160">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Image x:Name="FotoImage" Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Descripción:"
                                   FontFamily="InterBold"
                                   FontSize="18"
                                   TextColor="{StaticResource GrayDark}"/>
                            <Label x:Name="DescripcionLabel"
                                   FontFamily="InterRegular"
                                   FontSize="15"
                                   TextColor="{StaticResource GrayDark}"
                                   LineBreakMode="WordWrap"
                                   HorizontalTextAlignment="Justify"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Emisor del reporte:"
                                   FontFamily="InterBold"
                                   FontSize="18"
                                   TextColor="{StaticResource GrayDark}"/>
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Image Grid.Column="0"
                                       Source="icon_profile.svg"
                                       WidthRequest="30" HeightRequest="30"
                                       VerticalOptions="Center">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}"/>
                                    </Image.Behaviors>
                                </Image>
                                <Label Grid.Column="1"
                                       x:Name="EmisorLabel"
                                       FontFamily="InterRegular"
                                       FontSize="15"
                                       TextColor="{StaticResource GrayDark}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>

                        <Label Text="Estado del reporte:"
                               FontFamily="InterBold"
                               FontSize="18"
                               TextColor="{StaticResource GrayDark}"/>

                        <Border x:Name="EstadoBadge"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource StatusPending}"
                                Padding="16,8"
                                HorizontalOptions="Start">
                            <Label x:Name="EstadoLabel"
                                   Text="Pendiente"
                                   FontFamily="InterBold"
                                   FontSize="15"
                                   TextColor="{StaticResource WhiteBase}"/>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Botones de acción -->
                <VerticalStackLayout Grid.Row="1"
                                     Spacing="8"
                                     Padding="20,8,20,14">
                    <Button x:Name="AvanzarEstadoButton"
                            Text="Avanzar estado"
                            Style="{StaticResource PrimaryButton}"
                            Padding="0"
                            HeightRequest="44"
                            Clicked="OnActualizarEstadoTapped"/>
                    <Button Text="Penalizar emisor"
                            Style="{StaticResource DangerButton}"
                            Padding="0"
                            HeightRequest="44"
                            Clicked="OnPenalizarTapped"/>
                    <Button Text="Volver"
                            FontFamily="InterExtraBold"
                            FontSize="18"
                            BackgroundColor="{StaticResource GrayDark}"
                            TextColor="{StaticResource GrayLight}"
                            CornerRadius="32"
                            Padding="0"
                            HeightRequest="44"
                            HorizontalOptions="Fill"
                            Clicked="OnVolverTapped">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource BlackBase}" Offset="0,1" Radius="5" Opacity="0.25"/>
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>

            </Grid>
        </Grid>
    </Border>
</ContentView>
