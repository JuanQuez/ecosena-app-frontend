<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:EcosenaApp.Models.Report"
             x:Class="EcosenaApp.Views.Controls.ReportsAdminView">

    <Grid RowDefinitions="Auto, Auto, Auto, *" RowSpacing="10" Margin="0, 10">

        <!-- Estadísticas 2x2 -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*, *"
              RowDefinitions="Auto, Auto"
              ColumnSpacing="16"
              RowSpacing="16">

            <!-- Reportes totales -->
            <Border Grid.Row="0" Grid.Column="0"
                    BackgroundColor="{StaticResource GrayLight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="12">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="8" Opacity="0.25"/>
                </Border.Shadow>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                    <Label Text="Reportes totales"
                           FontFamily="InterMedium"
                           FontSize="12"
                           TextColor="{StaticResource GrayMidnight}"
                           LineBreakMode="WordWrap"/>
                    <Label x:Name="StatTotalLabel"
                           Text="0"
                           FontFamily="InterSemiBold"
                           FontSize="32"
                           TextColor="{StaticResource GrayDark}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Pendientes -->
            <Border Grid.Row="0" Grid.Column="1"
                    BackgroundColor="{StaticResource GrayLight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="12">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="8" Opacity="0.25"/>
                </Border.Shadow>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                    <Label Text="Pendientes"
                           FontFamily="InterMedium"
                           FontSize="12"
                           TextColor="{StaticResource GrayMidnight}"/>
                    <Label x:Name="StatPendingLabel"
                           Text="0"
                           FontFamily="InterSemiBold"
                           FontSize="32"
                           TextColor="{StaticResource GrayDark}"/>
                </VerticalStackLayout>
            </Border>

            <!-- En proceso -->
            <Border Grid.Row="1" Grid.Column="0"
                    BackgroundColor="{StaticResource GrayLight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="12">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="8" Opacity="0.25"/>
                </Border.Shadow>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                    <Label Text="En proceso"
                           FontFamily="InterMedium"
                           FontSize="12"
                           TextColor="{StaticResource GrayMidnight}"/>
                    <Label x:Name="StatInProgressLabel"
                           Text="0"
                           FontFamily="InterSemiBold"
                           FontSize="32"
                           TextColor="{StaticResource GrayDark}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Resueltos -->
            <Border Grid.Row="1" Grid.Column="1"
                    BackgroundColor="{StaticResource GrayLight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="12">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="8" Opacity="0.25"/>
                </Border.Shadow>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                    <Label Text="Resueltos"
                           FontFamily="InterMedium"
                           FontSize="12"
                           TextColor="{StaticResource GrayMidnight}"/>
                    <Label x:Name="StatSolvedLabel"
                           Text="0"
                           FontFamily="InterSemiBold"
                           FontSize="32"
                           TextColor="{StaticResource GrayDark}"/>
                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- Exportar a Excel -->
        <Button Grid.Row="1"
                Text="Exportar datos"
                Style="{StaticResource SecondaryButton}"
                HeightRequest="44"
                Command="{Binding ExportarExcelCommand}"
                IsEnabled="{Binding IsNotExporting}"/>

        <!-- Header "Gestión de reportes" -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource Summer}"
                Padding="10">
            <Border.Shadow>
                <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="8" Opacity="0.25"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                <Image Grid.Column="0"
                       Source="icon_arrow_down.svg"
                       WidthRequest="16" HeightRequest="15"
                       VerticalOptions="Center">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}"/>
                    </Image.Behaviors>
                </Image>
                <Label Grid.Column="1"
                       Text="Gestión de reportes"
                       FontFamily="InterExtraBold"
                       FontSize="20"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"/>
                <Image Grid.Column="2"
                       Source="icon_arrow_down.svg"
                       WidthRequest="16" HeightRequest="15"
                       VerticalOptions="Center">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}"/>
                    </Image.Behaviors>
                </Image>
            </Grid>
        </Border>

        <!-- Lista de reportes -->
        <Border Grid.Row="3"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <CollectionView x:Name="ReportesCollection"
                             SelectionMode="Single"
                             SelectionChanged="OnReporteSelected">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ReportListResDto">
                    <Border BackgroundColor="{StaticResource GrayLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource BlackBase}" Offset="0,1" Radius="5" Opacity="0.25"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="8, *">
                            <BoxView Grid.Column="0" BackgroundColor="{StaticResource StatusPending}">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="Pendiente">
                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusPending}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="EnProgreso">
                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusUnderReview}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="Resuelto">
                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusSolved}"/>
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="20" Padding="10">
                                <!-- Subcard de fecha -->
                                <Border Grid.Column="0"
                                        WidthRequest="40"
                                        BackgroundColor="{StaticResource WhiteBase}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 5">
                                    <Border.Shadow>
                                        <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="2" Opacity="0.25"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="0">
                                        <BoxView HeightRequest="10" BackgroundColor="{StaticResource StatusPending}">
                                            <BoxView.Triggers>
                                                <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="Pendiente">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource StatusPending}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="EnProgreso">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource StatusUnderReview}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="Resuelto">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource StatusSolved}"/>
                                                </DataTrigger>
                                            </BoxView.Triggers>
                                        </BoxView>
                                        <VerticalStackLayout Padding="5" Spacing="1" HorizontalOptions="Center">
                                            <Label Text="{Binding FechaEmision, StringFormat='{0:MMMM}'}"
                                                   FontFamily="InterExtraLight"
                                                   FontSize="8"
                                                   HorizontalTextAlignment="Center"
                                                   TextColor="{StaticResource GrayDark}"/>
                                            <Label Text="{Binding FechaEmision, StringFormat='{0:dd}'}"
                                                   FontFamily="InterBold"
                                                   FontSize="18"
                                                   HorizontalTextAlignment="Center"
                                                   TextColor="{StaticResource GrayDark}"/>
                                            <Label Text="{Binding FechaEmision, StringFormat='{0:yyyy}'}"
                                                   FontFamily="InterExtraLight"
                                                   FontSize="8"
                                                   HorizontalTextAlignment="Center"
                                                   TextColor="{StaticResource GrayDark}"/>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="{Binding Ubicacion}"
                                           FontFamily="InterRegular"
                                           FontSize="16"
                                           TextColor="{StaticResource GrayDark}"/>
                                    <Label Text="{Binding FechaEmision, StringFormat='{0:d MMM yyyy}'}"
                                           FontFamily="InterRegular"
                                           FontSize="12"
                                           TextColor="{StaticResource GrayMidnight}"/>
                                </VerticalStackLayout>
                                <Image Grid.Column="2"
                                       WidthRequest="24"
                                       HeightRequest="24"
                                       VerticalOptions="Center"
                                       Source="icon_detail_pending_report.svg">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding Estado}" Value="Pendiente">
                                            <Setter Property="Source" Value="icon_detail_pending_report.svg"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image" Binding="{Binding Estado}" Value="EnProgreso">
                                            <Setter Property="Source" Value="icon_detail_inprogress_report.svg"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image" Binding="{Binding Estado}" Value="Resuelto">
                                            <Setter Property="Source" Value="icon_detail_solved_report.svg"/>
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

    </Grid>
</ContentView>
