<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:EcosenaApp.Models.Report"
             x:Class="EcosenaApp.Views.Controls.ReportsAdminView">

    <Grid RowDefinitions="Auto, Auto, Auto, *" RowSpacing="10">

        <!-- Estadísticas 2x2 -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*, *"
              RowDefinitions="Auto, Auto"
              ColumnSpacing="16"
              RowSpacing="16">

            <!-- Generados este mes -->
            <Border Grid.Row="0" Grid.Column="0"
                    BackgroundColor="{StaticResource GrayLight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="12">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="8" Opacity="0.25"/>
                </Border.Shadow>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                    <Label Text="Generados este mes"
                           FontFamily="InterMedium"
                           FontSize="12"
                           TextColor="{StaticResource GrayMidnight}"
                           LineBreakMode="WordWrap"/>
                    <Label x:Name="StatTotalLabel"
                           Text="0"
                           FontFamily="InterSemiBold"
                           FontSize="32"
                           TextColor="{StaticResource GrayDark}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Pendientes -->
            <Border Grid.Row="0" Grid.Column="1"
                    BackgroundColor="{StaticResource GrayLight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="12">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="8" Opacity="0.25"/>
                </Border.Shadow>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                    <Label Text="Pendientes"
                           FontFamily="InterMedium"
                           FontSize="12"
                           TextColor="{StaticResource GrayMidnight}"/>
                    <Label x:Name="StatPendingLabel"
                           Text="0"
                           FontFamily="InterSemiBold"
                           FontSize="32"
                           TextColor="{StaticResource GrayDark}"/>
                </VerticalStackLayout>
            </Border>

            <!-- En proceso -->
            <Border Grid.Row="1" Grid.Column="0"
                    BackgroundColor="{StaticResource GrayLight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="12">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="8" Opacity="0.25"/>
                </Border.Shadow>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                    <Label Text="En proceso"
                           FontFamily="InterMedium"
                           FontSize="12"
                           TextColor="{StaticResource GrayMidnight}"/>
                    <Label x:Name="StatInProgressLabel"
                           Text="0"
                           FontFamily="InterSemiBold"
                           FontSize="32"
                           TextColor="{StaticResource GrayDark}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Resueltos este mes -->
            <Border Grid.Row="1" Grid.Column="1"
                    BackgroundColor="{StaticResource GrayLight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="12">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="8" Opacity="0.25"/>
                </Border.Shadow>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                    <Label Text="Resueltos este mes"
                           FontFamily="InterMedium"
                           FontSize="12"
                           TextColor="{StaticResource GrayMidnight}"/>
                    <Label x:Name="StatSolvedLabel"
                           Text="0"
                           FontFamily="InterSemiBold"
                           FontSize="32"
                           TextColor="{StaticResource GrayDark}"/>
                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- Exportar a Excel -->
        <Button Grid.Row="1"
                Text="Exportar Excel"
                Style="{StaticResource SecondaryButton}"
                HeightRequest="44"
                Command="{Binding ExportarExcelCommand}"
                IsEnabled="{Binding IsNotExporting}"/>

        <!-- Header "Gestión de reportes" -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource Summer}"
                Padding="10">
            <Border.Shadow>
                <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="8" Opacity="0.25"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                <Image Grid.Column="0"
                       Source="icon_arrow_down.svg"
                       WidthRequest="16" HeightRequest="15"
                       VerticalOptions="Center">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}"/>
                    </Image.Behaviors>
                </Image>
                <Label Grid.Column="1"
                       Text="Gestión de reportes"
                       FontFamily="InterExtraBold"
                       FontSize="20"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"/>
                <Image Grid.Column="2"
                       Source="icon_arrow_down.svg"
                       WidthRequest="16" HeightRequest="15"
                       VerticalOptions="Center">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}"/>
                    </Image.Behaviors>
                </Image>
            </Grid>
        </Border>

        <!-- Lista de reportes -->
        <CollectionView Grid.Row="3"
                         x:Name="ReportesCollection"
                         SelectionMode="Single"
                         SelectionChanged="OnReporteSelected">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ReportListResDto">
                    <Border BackgroundColor="{StaticResource GrayLight}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="8, *, Auto" Padding="10">
                            <BoxView Grid.Column="0" BackgroundColor="{StaticResource StatusUnderReview}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding Ubicacion}"
                                       FontFamily="InterRegular"
                                       FontSize="16"
                                       TextColor="{StaticResource GrayDark}"/>
                                <Label Text="{Binding FechaEmision, StringFormat='{0:d MMM yyyy}'}"
                                       FontFamily="InterRegular"
                                       FontSize="12"
                                       TextColor="{StaticResource GrayMidnight}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding Estado}"
                                   FontFamily="InterBold"
                                   FontSize="12"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource Primary}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentView>
