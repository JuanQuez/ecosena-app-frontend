<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EcosenaApp.Models.Blog"
             x:Class="EcosenaApp.Views.Controls.BlogContainerView">

    <Grid RowDefinitions="Auto,Auto,Auto,*" VerticalOptions="Center" Margin="0, 10" RowSpacing="20">

        <!-- ====| HEADER CARD (Fixed) |==== -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource WhiteBlur}"
                Padding="20"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <Label Text="Blog Educativo"
                   TextColor="{StaticResource WhiteBase}"
                   Style="{StaticResource H2}"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"/>
        </Border>

        <!-- ====| SEARCH BAR (Fixed) |==== -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource WhiteBlur}"
                Padding="15, 5"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Entry Grid.Column="0"
                       Style="{StaticResource InputField}"
                       Placeholder="Buscar..."
                       PlaceholderColor="{StaticResource GrayLight}"
                       TextColor="{StaticResource WhiteBase}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"/>
                <Image Grid.Column="1"
                       Source="icon_search.png"
                       WidthRequest="24"
                       VerticalOptions="Center"
                       Margin="0,0,12,0"/>
            </Grid>
        </Border>

        <!-- ====| ADMIN: NUEVA ENTRADA |==== -->
        <Button Grid.Row="2"
                x:Name="NuevaEntradaButton"
                Text="Nueva entrada"
                Style="{StaticResource PrimaryButton}"
                HeightRequest="44"
                IsVisible="False"
                Clicked="OnNuevaEntradaTapped"/>

        <!-- ====| BLOG POST CARDS (Scrollable) |==== -->
        <Border Grid.Row="3"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30"/>
            </Border.StrokeShape>
            <CollectionView x:Name="EntradasCollection"
                             SelectionMode="Single"
                             SelectionChanged="OnEntradaSelected">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="20"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BlogListResDto">
                        <Border Style="{StaticResource PostCardBorder}">
                            <Grid ColumnDefinitions="145,*">
                                <Image Source="{Binding Portada, TargetNullValue='bkg_blog_cta.png'}" Aspect="AspectFill"/>
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Padding="12,14,12,12">
                                    <Label Grid.Row="0" Text="{Binding Titulo}" Style="{StaticResource PostTitleLabel}"/>
                                    <Label Grid.Row="1" Text="{Binding NombreRedactor}" Style="{StaticResource PostDescLabel}"/>
                                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" VerticalOptions="End">
                                        <Label Grid.Column="0" Text="{Binding FechaPublicacion, StringFormat='{0:d MMM yyyy}'}" VerticalTextAlignment="Center" Style="{StaticResource DateLabel}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

    </Grid>

</ContentView>
