<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EcosenaApp.Views.Controls"
             x:Class="EcosenaApp.Views.Controls.HomeContainerView">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="20" VerticalOptions="Center" Margin="0, 10">

            <!-- ====| HERO BANNER (dinámico por rol) |==== -->
            <ContentView x:Name="HeroSlot" />

            <!-- ====| LO MÁS RECIENTE |==== -->
            <controls:RecentBlogView x:Name="RecentBlogPanel" />

            <!-- ====| INFORMACIÓN DE INTERÉS |==== -->
            <controls:InterestInfoView />

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
