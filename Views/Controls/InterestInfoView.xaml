<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EcosenaApp.Views.Controls.InterestInfoView">

    <VerticalStackLayout Spacing="20">
        <!-- ====| HEADER & CHIPS |==== -->
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0"
                           Text="INFORMACIÓN DE INTERÉS"
                           Style="{StaticResource H2}"
                           TextColor="{StaticResource WhiteBase}" />
                </Grid>

                <HorizontalStackLayout Spacing="10">
                    <Border Style="{StaticResource ContentChip}">
                        <HorizontalStackLayout Spacing="6">
                            <Image Source="icon_sena_logo.svg" HeightRequest="16" WidthRequest="16">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource WhiteBase}" />
                                </Image.Behaviors>
                            </Image>
                            <Label Text="SENA"
                                   Style="{StaticResource TextRegular}"
                                   TextColor="{StaticResource WhiteBase}"
                                   FontSize="12" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- ====| CARDS |==== -->
        <VerticalStackLayout Spacing="12" VerticalOptions="Start" HorizontalOptions="Fill">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource Fantasy}"
                    VerticalOptions="Start">
                <Grid ColumnDefinitions="Auto, *" HeightRequest="90">
                    <Image Grid.Column="0"
                           Source="bkg_ecosena_auth.png"
                           Aspect="AspectFill"
                           WidthRequest="100"
                           HeightRequest="90" />
                    <VerticalStackLayout Grid.Column="1" Padding="14,12" Spacing="8" VerticalOptions="Center">
                        <Label Text="Como navegar por la app"
                               Style="{StaticResource TextRegular}"
                               TextColor="{StaticResource GrayDark}"
                               FontSize="16"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap" />
                        <Border Style="{StaticResource ActionChipPrimary}">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="Ver instructivo"
                                       Style="{StaticResource TextRegular}"
                                       TextColor="{StaticResource Fantasy}"
                                       FontSize="12" />
                                <Image Source="icon_arrow_right.png" VerticalOptions="Fill">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Fantasy}" />
                                    </Image.Behaviors>
                                </Image>
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </VerticalStackLayout>

</ContentView>