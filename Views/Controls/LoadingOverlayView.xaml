<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcosenaApp.Views.Controls.LoadingOverlayView"
             InputTransparent="False">

    <Grid x:Name="OverlayRoot"
          IsVisible="False"
          InputTransparent="False"
          BackgroundColor="#66000000">

        <Border BackgroundColor="{StaticResource WhiteBase}"
                StrokeThickness="0"
                Padding="28,24"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource BlackBase}"
                        Offset="0,2"
                        Radius="8"
                        Opacity="0.3"/>
            </Border.Shadow>
            <ActivityIndicator x:Name="Spinner"
                                IsRunning="False"
                                Color="{StaticResource Primary}"
                                HeightRequest="36"
                                WidthRequest="36"/>
        </Border>
    </Grid>

</ContentView>
