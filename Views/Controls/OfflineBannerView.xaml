<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EcosenaApp.Views.Controls.OfflineBannerView"
             IsVisible="False">

    <Border BackgroundColor="{StaticResource ActionDelete}"
            StrokeThickness="0"
            Padding="16,10"
            Margin="0,8,0,0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <Image Source="icon_no_wifi.svg" HeightRequest="16" WidthRequest="16">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{StaticResource WhiteBase}" />
                </Image.Behaviors>
            </Image>
            <Label Text="Sin conexión a internet"
                   Style="{StaticResource TextRegular}"
                   TextColor="{StaticResource WhiteBase}"
                   FontSize="12" />
        </HorizontalStackLayout>
    </Border>

</ContentView>
