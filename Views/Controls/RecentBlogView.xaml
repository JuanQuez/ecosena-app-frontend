<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EcosenaApp.Views.Controls.RecentBlogView">

    <Border StrokeThickness="0" StrokeShape="RoundRectangle 15">
        <Grid RowDefinitions="Auto, *" RowSpacing="10">
            <!-- Header -->
            <Grid RowDefinitions="Auto" ColumnDefinitions="*, Auto">
                <Label Grid.Column="0"
                       Text="LO MÁS RECIENTE"
                       Style="{StaticResource H2}"
                       TextColor="{StaticResource WhiteBase}" />
                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    <Label Text="Ver todos"
                           Style="{StaticResource TextRegular}"
                           TextColor="{StaticResource WhiteBase}"
                           FontSize="12" />
                    <Image Source="icon_arrow_redirect.svg"
                           VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnViewAllTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
            </Grid>

            <!-- Content -->
            <VerticalStackLayout Grid.Row="1" VerticalOptions="Fill">

                <Label x:Name="SinEntradasLabel"
                       Text="Aún no hay entradas publicadas en el blog."
                       Style="{StaticResource TextRegular}"
                       TextColor="{StaticResource WhiteBase}"
                       IsVisible="False"/>

                <Border x:Name="EntradaCard"
                        StrokeThickness="1" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource Primary}">
                    <Grid ColumnDefinitions="*, Auto" HeightRequest="180">
                        <VerticalStackLayout Grid.Column="0" Padding="15, 10, 0, 10" Spacing="10">
                            <Label x:Name="AutorLabel" Style="{StaticResource TextSecondary}" TextColor="{StaticResource GrayLight}" />
                            <Label x:Name="TituloLabel" Style="{StaticResource H2}" TextColor="{StaticResource WhiteBase}" LineBreakMode="WordWrap" MaxLines="2"/>
                            <Label x:Name="FechaLabel" FontSize="14" Style="{StaticResource TextSecondary}" TextColor="{StaticResource GrayLight}" />
                            <Border Style="{StaticResource ActionChip}" Margin="0,6,0,0">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Leer artículo" Style="{StaticResource TextMedium}" TextColor="{StaticResource Primary}" FontSize="14" FontAttributes="Bold" />
                                    <Image Source="icon_arrow_right.png" VerticalOptions="Fill">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                        </Image.Behaviors>
                                    </Image>
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                        <Image x:Name="PortadaImage" Grid.Column="1" Source="bkg_blog_cta.png" Aspect="AspectFill" WidthRequest="130" VerticalOptions="Fill"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEntradaTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </Border>

</ContentView>
