<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EcosenaApp.Views.Controls.ReportFormUserView">

    <Border StrokeThickness="0"
            StrokeShape="RoundRectangle 15">

        <Grid>
            <Image Source="bkg_ecosena_managment.png"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"/>

            <Grid RowDefinitions="*, Auto">

                <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="16"
                                     Padding="16,12,16,6">

                    <Label Text="Crear Reporte"
                           FontFamily="InterExtraBold"
                           FontSize="20"
                           TextColor="{StaticResource GrayDark}"
                           LineBreakMode="WordWrap"/>

                    <Label x:Name="SancionLabel"
                           Text="Tu acceso a reportes está restringido."
                           FontFamily="InterBold"
                           FontSize="14"
                           TextColor="{StaticResource StatusPending}"
                           IsVisible="False"/>

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource WhiteBase}"
                            HeightRequest="48"
                            Padding="12,0">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource BlackBase}" Offset="0,1" Radius="5" Opacity="0.25"/>
                        </Border.Shadow>
                        <Entry x:Name="TituloEntry"
                               Placeholder="Titulo del reporte..."
                               Style="{StaticResource InputField}"
                               FontSize="16"/>
                    </Border>

                    <Border StrokeThickness="0"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource WhiteBase}"
                            MinimumHeightRequest="120"
                            Padding="12,8">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource BlackBase}" Offset="0,1" Radius="5" Opacity="0.25"/>
                        </Border.Shadow>
                        <Editor x:Name="DescripcionEditor"
                                Placeholder="Descripción..."
                                FontFamily="InterRegular"
                                AutoSize="TextChanges"
                                FontSize="15"
                                TextColor="{StaticResource BlackBase}"
                                PlaceholderColor="{StaticResource GrayMedium}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Start"/>
                    </Border>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Evidencia fotográfica:"
                               FontFamily="InterBold"
                               FontSize="15"
                               TextColor="{StaticResource GrayDark}"/>
                        <HorizontalStackLayout Spacing="12">
                            <Border StrokeThickness="1.5"
                                    Stroke="{StaticResource GrayMidnight}"
                                    StrokeDashArray="4,4"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource WhiteBase}"
                                    WidthRequest="60" HeightRequest="60">
                                <Image x:Name="FotoPreviewImage"
                                       Source="icon_gallery_report.svg"
                                       WidthRequest="28" HeightRequest="28"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Aspect="AspectFill">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource GrayMidnight}"/>
                                    </Image.Behaviors>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAbrirGaleriaTapped"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Border>
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource WhiteBase}"
                                    WidthRequest="60" HeightRequest="60">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,1" Radius="5" Opacity="0.25"/>
                                </Border.Shadow>
                                <Image Source="icon_camera_report.svg"
                                       WidthRequest="32" HeightRequest="32"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}"/>
                                    </Image.Behaviors>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAbrirCamaraTapped"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource WhiteBase}"
                            HeightRequest="48"
                            Padding="8,0">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource BlackBase}" Offset="0,1" Radius="5" Opacity="0.25"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                            <Image Grid.Column="0"
                                   Source="icon_location.svg"
                                   WidthRequest="22" HeightRequest="22"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}"/>
                                </Image.Behaviors>
                            </Image>
                            <Picker Grid.Column="1"
                                    x:Name="AmbientePicker"
                                    Title="Selecciona un ambiente"
                                    FontSize="15"
                                    TextColor="{StaticResource BlackBase}"
                                    BackgroundColor="Transparent"/>
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Spacing="8">
                        <Image Source="icon_calendar.svg"
                               WidthRequest="20" HeightRequest="20"
                               VerticalOptions="Center">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}"/>
                            </Image.Behaviors>
                        </Image>
                        <Label x:Name="FechaLabel"
                               FontFamily="InterRegular"
                               FontSize="14"
                               TextColor="{StaticResource GrayDark}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout Grid.Row="1"
                                     Spacing="8"
                                     Padding="16,8,16,14">
                    <Grid>
                        <Button x:Name="GenerarReporteButton"
                                Text="Generar reporte"
                                Style="{StaticResource PrimaryButton}"
                                Padding="0"
                                HeightRequest="44"
                                IsVisible="{Binding IsNotBusy}"
                                Clicked="OnGenerarReporteTapped"/>
                        <Border Background="{StaticResource PrimaryGradient}"
                                StrokeThickness="0"
                                HeightRequest="44"
                                HorizontalOptions="Fill"
                                IsVisible="{Binding IsBusy}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="50"/>
                            </Border.StrokeShape>
                            <ActivityIndicator IsRunning="True"
                                               Color="{StaticResource WhiteBase}"
                                               HeightRequest="24"
                                               HorizontalOptions="Center"/>
                        </Border>
                    </Grid>
                    <Button Text="Cancelar"
                            Style="{StaticResource DangerButton}"
                            Padding="0"
                            HeightRequest="44"
                            Clicked="OnCancelarTapped"/>
                </VerticalStackLayout>

            </Grid>
        </Grid>
    </Border>
</ContentView>
