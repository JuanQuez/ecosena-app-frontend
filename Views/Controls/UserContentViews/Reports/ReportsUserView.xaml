<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:EcosenaApp.Views.Controls"
             xmlns:models="clr-namespace:EcosenaApp.Models.Report"
             x:Class="EcosenaApp.Views.Controls.ReportsUserView">

    <Grid>

        <VerticalStackLayout x:Name="ListSection" Spacing="10">

            <!-- Hero CTA -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 15">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="15" Opacity="0.25"/>
                </Border.Shadow>
                <Grid HeightRequest="180">
                    <Image Source="bkg_reports_section.png"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"/>
                    <BoxView Color="#B31E1E1E"/>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="10"
                                         Padding="40,16">
                        <Label Text="Tu voz cuenta"
                               FontFamily="InterExtraBold"
                               FontSize="24"
                               TextColor="{StaticResource GrayLight}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Tus reportes nos ayudan a ser mejores cada dia."
                               FontFamily="InterRegular"
                               FontSize="16"
                               TextColor="{StaticResource GrayLight}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                        <Button Text="Reporta aquí"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="18"
                                Padding="30,8"
                                HorizontalOptions="Center"
                                Clicked="OnReportarTapped"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Header -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource Summer}"
                    Padding="10">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,4" Radius="2" Opacity="0.25"/>
                </Border.Shadow>
                <Label Text="Tus últimos reportes"
                       FontFamily="InterBold"
                       FontSize="18"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center"/>
            </Border>

            <!-- Lista de reportes -->
            <CollectionView x:Name="ReportesCollection"
                             HeightRequest="400">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ReportListResDto">
                        <Border BackgroundColor="{StaticResource GrayLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="8, *, Auto" Padding="10">
                                <BoxView Grid.Column="0" BackgroundColor="{StaticResource StatusPending}"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Ubicacion}"
                                           FontFamily="InterRegular"
                                           FontSize="16"
                                           TextColor="{StaticResource GrayDark}"/>
                                    <Label Text="{Binding FechaEmision, StringFormat='{0:d MMM yyyy}'}"
                                           FontFamily="InterRegular"
                                           FontSize="12"
                                           TextColor="{StaticResource GrayMidnight}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Estado}"
                                       FontFamily="InterBold"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Primary}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

        <controls:ReportFormUserView x:Name="FormSection"
                                      IsVisible="False"
                                      GenerarReporteClicked="OnGenerarReporteTapped"
                                      CancelarClicked="OnCancelarFormTapped"
                                      AbrirGaleriaClicked="OnAbrirGaleriaTapped"
                                      AbrirCamaraClicked="OnAbrirCamaraTapped"/>

    </Grid>
</ContentView>
