<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:EcosenaApp.Views.Controls"
             xmlns:models="clr-namespace:EcosenaApp.Models.Report"
             x:Class="EcosenaApp.Views.Controls.ReportsUserView">

    <Grid Margin="0, 10">

        <VerticalStackLayout x:Name="ListSection" Spacing="10">

            <!-- Hero CTA -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 15">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="15" Opacity="0.25"/>
                </Border.Shadow>
                <Grid HeightRequest="180">
                    <Image Source="bkg_reports_section.png"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"/>
                    <BoxView Color="#B31E1E1E"/>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="10"
                                         Padding="40,16">
                        <Label Text="Tu voz cuenta"
                               FontFamily="InterExtraBold"
                               FontSize="24"
                               TextColor="{StaticResource GrayLight}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Tus reportes nos ayudan a ser mejores cada dia."
                               FontFamily="InterRegular"
                               FontSize="16"
                               TextColor="{StaticResource GrayLight}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                        <Button Text="Reporta aquí"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="18"
                                Padding="30,8"
                                HorizontalOptions="Center"
                                Clicked="OnReportarTapped"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Header -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource Summer}"
                    Padding="10">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BlackBase}" Offset="0,4" Radius="2" Opacity="0.25"/>
                </Border.Shadow>
                <Label Text="Tus últimos reportes"
                       FontFamily="InterBold"
                       FontSize="18"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center"/>
            </Border>

            <!-- Lista de reportes -->
            <Border HeightRequest="400"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <CollectionView x:Name="ReportesCollection">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ReportListResDto">
                        <Border BackgroundColor="{StaticResource GrayLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource BlackBase}" Offset="0,1" Radius="5" Opacity="0.25"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="8, *">
                                <BoxView Grid.Column="0" BackgroundColor="{StaticResource StatusPending}">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="Pendiente">
                                            <Setter Property="BackgroundColor" Value="{StaticResource StatusPending}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="EnProgreso">
                                            <Setter Property="BackgroundColor" Value="{StaticResource StatusUnderReview}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="Resuelto">
                                            <Setter Property="BackgroundColor" Value="{StaticResource StatusSolved}"/>
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <Grid Grid.Column="1" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="20" Padding="10">
                                    <!-- Subcard de fecha -->
                                    <Border Grid.Column="0"
                                            WidthRequest="40"
                                            BackgroundColor="{StaticResource WhiteBase}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 5">
                                        <Border.Shadow>
                                            <Shadow Brush="{StaticResource BlackBase}" Offset="0,0" Radius="2" Opacity="0.25"/>
                                        </Border.Shadow>
                                        <VerticalStackLayout Spacing="0">
                                            <BoxView HeightRequest="10" BackgroundColor="{StaticResource StatusPending}">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="Pendiente">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusPending}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="EnProgreso">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusUnderReview}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Estado}" Value="Resuelto">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusSolved}"/>
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>
                                            <VerticalStackLayout Padding="5" Spacing="1" HorizontalOptions="Center">
                                                <Label Text="{Binding FechaEmision, StringFormat='{0:MMMM}'}"
                                                       FontFamily="InterExtraLight"
                                                       FontSize="8"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{StaticResource GrayDark}"/>
                                                <Label Text="{Binding FechaEmision, StringFormat='{0:dd}'}"
                                                       FontFamily="InterBold"
                                                       FontSize="18"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{StaticResource GrayDark}"/>
                                                <Label Text="{Binding FechaEmision, StringFormat='{0:yyyy}'}"
                                                       FontFamily="InterExtraLight"
                                                       FontSize="8"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{StaticResource GrayDark}"/>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label Text="{Binding Ubicacion}"
                                               FontFamily="InterRegular"
                                               FontSize="16"
                                               TextColor="{StaticResource GrayDark}"/>
                                        <Label Text="{Binding FechaEmision, StringFormat='{0:d MMM yyyy}'}"
                                               FontFamily="InterRegular"
                                               FontSize="12"
                                               TextColor="{StaticResource GrayMidnight}"/>
                                    </VerticalStackLayout>
                                    <Image Grid.Column="2"
                                           WidthRequest="24"
                                           HeightRequest="24"
                                           VerticalOptions="Center"
                                           Source="icon_pendient_report.svg">
                                        <Image.Triggers>
                                            <DataTrigger TargetType="Image" Binding="{Binding Estado}" Value="Pendiente">
                                                <Setter Property="Source" Value="icon_pendient_report.svg"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Image" Binding="{Binding Estado}" Value="EnProgreso">
                                                <Setter Property="Source" Value="icon_inprogress_report.svg"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Image" Binding="{Binding Estado}" Value="Resuelto">
                                                <Setter Property="Source" Value="icon_solved_report.svg"/>
                                            </DataTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

        </VerticalStackLayout>

        <controls:ReportFormUserView x:Name="FormSection"
                                      IsVisible="False"
                                      GenerarReporteClicked="OnGenerarReporteTapped"
                                      CancelarClicked="OnCancelarFormTapped"
                                      AbrirGaleriaClicked="OnAbrirGaleriaTapped"
                                      AbrirCamaraClicked="OnAbrirCamaraTapped"/>

        <controls:LoadingOverlayView x:Name="FormLoadingOverlay" IsBusy="False"/>

    </Grid>
</ContentView>
