<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EcosenaApp.Views.Controls"
             x:Class="EcosenaApp.Views.Host.HostPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="bkg_ecosena_sections.png">
    
    <Grid RowDefinitions="Auto, *, Auto" Margin="20, 10">
        <!-- Persistent TopBar -->
        <controls:TopBarView x:Name="MainTopBar" Grid.Row="0" />

        <!-- Dynamic content region -->
        <ContentView x:Name="ContentRegion" Grid.Row="1" />

        <!-- Banner flotante de "sin conexión" (misma celda que ContentRegion, ancla arriba, no empuja nada) -->
        <controls:OfflineBannerView Grid.Row="1" VerticalOptions="Start" />

        <!-- Persistent Footer -->
        <controls:FootBarView x:Name="MainFootBar" Grid.Row="2" />

        <!-- Overlay de carga a pantalla completa (cubre TopBar+contenido+FootBar) -->
        <controls:LoadingOverlayView x:Name="HostLoadingOverlay" Grid.Row="0" Grid.RowSpan="3" IsBusy="False"/>
    </Grid>

</ContentPage>