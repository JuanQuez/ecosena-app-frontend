<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcosenaApp.Views.Profile.InfoTextPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Primary}">

    <Grid RowDefinitions="Auto,*" Padding="0">

        <!-- ====| HEADER |==== -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Padding="20,16,20,24"
              VerticalOptions="Start">

            <ImageButton Grid.Column="0"
                         Source="icon_goback.svg"
                         BackgroundColor="Transparent"
                         HeightRequest="32"
                         WidthRequest="32"
                         Clicked="OnBackClicked"
                         HorizontalOptions="Start"/>

            <Label x:Name="TitleLabel"
                   Grid.Column="1"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Style="{StaticResource H1}"
                   TextColor="{StaticResource WhiteBase}"/>
        </Grid>

        <!-- ====| CONTENT |==== -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <Border BackgroundColor="{StaticResource WhiteBase}"
                    StrokeThickness="0"
                    Padding="20,24"
                    Margin="20,0,20,32"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>

                <Label x:Name="BodyLabel"
                       Style="{StaticResource TextRegular}"
                       TextColor="{StaticResource GrayDark}"
                       LineBreakMode="WordWrap"/>
            </Border>
        </ScrollView>

    </Grid>

</ContentPage>
